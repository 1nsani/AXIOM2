# ===================================================
# AXIOM — Idea Engine : Environment Variables
# ===================================================
# Salin file ini menjadi .env.local (untuk lokal) atau
# isi di dashboard Vercel saat deploy.

# DeepSeek API Key (wajib)
# Dapatkan dari https://platform.deepseek.com/api_keys
# Digunakan oleh API Routes: /api/parse-idea dan /api/audit-logic
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# Tidak ada variabel lain yang diperlukan untuk saat ini.
# Jika di masa depan kamu mengaktifkan penyimpanan (Supabase dsb),
# tambahkan di sini.
